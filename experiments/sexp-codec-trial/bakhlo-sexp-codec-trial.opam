opam-version: "2.0"
synopsis: "Isolated synthetic Parsexp codec trial for Bakhlo"
description: """
A disposable experiment for evaluating a versioned S-expression wire boundary.
It is not the Bakhlo package and does not select the canonical persistence format.
"""
maintainer: "Bakhlo maintainers"
depends: [
  "ocaml" {= "5.3.0"}
  "dune" {= "3.24.2"}
  "parsexp" {= "v0.17.0"}
  "sexplib0" {= "v0.17.0"}
  "zarith" {= "1.14"}
]
build: [
  ["dune" "build"]
]
