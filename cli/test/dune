; Every bk command on synthetic books (cli_checks.ml), what every read-only command
; shows on one synthetic year (views.ml against views.expected), and what Tab offers
; (completion.sh against completion.expected).

(executable
 (name cli_checks)
 (modules cli_checks line_commands_checks)
 (libraries bakhlo_cli bakhlo.household bakhlo.store unix zarith))

(rule
 (alias runtest)
 (action
  (run %{exe:cli_checks.exe})))

(executable
 (name views)
 (modules views)
 (libraries bakhlo_cli bakhlo.store unix))

(rule
 (with-stdout-to
  views.out
  (run %{exe:views.exe})))

(rule
 (alias runtest)
 (action
  (diff views.expected views.out)))

; Tab completion of the bk commands in bash (tools/bk-completion.bash).

(rule
 (with-stdout-to
  completion.out
  (run
   bash
   %{dep:completion.sh}
   %{dep:../../tools/bk-completion.bash}
   %{exe:../bakhlo.exe})))

(rule
 (alias runtest)
 (action
  (diff completion.expected completion.out)))
