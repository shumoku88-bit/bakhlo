 (public_name bakhlo.cli)
 (wrapped false)
 (modules :standard \ bakhlo)
 (libraries bakhlo.household bakhlo.book_txt bakhlo.store unix zarith))

(executable
 (name bakhlo)
 (modules bakhlo)
 (libraries bakhlo_cli))
