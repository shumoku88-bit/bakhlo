; SYNTHETIC ONLY. Supplied initial evidence, not a live household or recording permission.
(bakhlo 1 ordinary-quantity)

(collections
  (provided measures observations zero-origin)
  (empty events event-corrections)
  (not-supplied))

(measure "jpy" (decimal-scale 0))

(observation
  (reflected-roots)
  (assertion (locus "wallet") (measure "jpy") (quanta 1000)))

(zero-origin (locus "food") (measure "jpy"))
