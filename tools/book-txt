#!/bin/sh
# The household's move to the common book.txt (docs/COMMON_FORMAT.ja.md).
#
#   tools/book-txt trial    copy the household's book, roles, Attention and settlements
#                           into scratch/, convert the copy and compare it with the
#                           source. The household is only read and must be
#                           byte-identical afterwards.
#   tools/book-txt migrate  the one-time, user-approved migration: with a clean
#                           household Git tree and no TUI holding the writer lock,
#                           convert and compare, write book.txt, read it back and
#                           compare again, then commit book.txt and remove book.sexp,
#                           accounting-roles.tsv and attention.loam (they are inside
#                           book.txt now; Git keeps them). Nothing is pushed.
# BAKHLO_HOUSEHOLD overrides the household directory (default: ../bakhlo-data).
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"
case "${1:-}" in
  trial|migrate) [ "$#" -eq 1 ] || exit 2 ;;
  *) printf '%s\n' 'Usage: tools/book-txt trial | migrate' >&2; exit 2 ;;
esac
source=$(CDPATH= cd -- "${BAKHLO_HOUSEHOLD:-$root/../bakhlo-data}" 2>/dev/null && pwd -P) || {
  printf '%s\n' 'No household directory; nothing converted.' >&2; exit 2; }
[ -f "$source/book.sexp" ] || { printf '%s\n' 'No household book.sexp; nothing converted.' >&2; exit 2; }
[ ! -L "$root/scratch" ] || exit 2
mkdir -p scratch
run=$(mktemp -d "$root/scratch/book-txt-$1-XXXXXX")
build=$run/build
mkdir "$build"
./tools/opam exec -- dune build lib/bakhlo_domain.cmxa application/bakhlo_application.cmxa \
  book_txt/bakhlo_book_txt.cmxa loam_read/bakhlo_loam_read.cmxa sexp/bakhlo_sexp.cmxa \
  migrate/bakhlo_migrate.cmxa store/bakhlo_store.cmxa
cp tools/book_txt_tool.ml "$build/"
objs() { for lib in "$@"; do printf -- '-I _build/default/%s/.%s.objs/byte -I _build/default/%s/.%s.objs/native ' \
  "${lib%%:*}" "${lib#*:}" "${lib%%:*}" "${lib#*:}"; done; }
# shellcheck disable=SC2046
./tools/opam exec -- ocamlfind ocamlopt -strict-sequence -w +8+9+11 -warn-error +8+9+11 \
  -package base,zarith,parsexp,unix -linkpkg \
  $(objs lib:bakhlo_domain application:bakhlo_application book_txt:bakhlo_book_txt \
    loam_read:bakhlo_loam_read sexp:bakhlo_sexp migrate:bakhlo_migrate store:bakhlo_store) \
  -I _build/default/store \
  _build/default/lib/bakhlo_domain.cmxa _build/default/application/bakhlo_application.cmxa \
  _build/default/book_txt/bakhlo_book_txt.cmxa _build/default/loam_read/bakhlo_loam_read.cmxa \
  _build/default/sexp/bakhlo_sexp.cmxa _build/default/migrate/bakhlo_migrate.cmxa \
  _build/default/store/bakhlo_store.cmxa \
  "$build/book_txt_tool.ml" -o "$build/book-txt-tool"
files='book.sexp config/accounting-roles.tsv accounting-roles.tsv attention.loam settlements.tsv'

if [ "$1" = trial ]; then
  digest() { (cd "$source" && for f in $files; do [ ! -f "$f" ] || shasum -a 256 "$f"; done); }
  before=$(digest)
  for f in $files; do
    if [ -f "$source/$f" ]; then mkdir -p "$(dirname "$run/copy/$f")"; cp -p "$source/$f" "$run/copy/$f"; fi
  done
  [ "$before" = "$(digest)" ] || { printf '%s\n' 'The household changed while copying; nothing converted.' >&2; exit 2; }
  status=0
  "$build/book-txt-tool" trial "$run/copy" "$run" || status=$?
  [ "$before" = "$(digest)" ] || { printf '%s\n' 'The household changed during the trial.' >&2; exit 2; }
  printf 'Household files byte-identical before and after. Copy and result: %s\n' "$run"
  exit "$status"
fi

# migrate
[ -d "$source/.git" ] || { printf '%s\n' 'The household is not a Git repository; nothing migrated.' >&2; exit 2; }
[ ! -e "$source/book.txt" ] || { printf '%s\n' 'book.txt already exists; nothing migrated.' >&2; exit 2; }
if [ -n "$(git -C "$source" status --porcelain)" ]; then
  printf '%s\n' 'The household has uncommitted changes; commit them first. Nothing migrated.' >&2
  exit 2
fi
"$build/book-txt-tool" migrate "$source"
git -C "$source" add book.txt
for f in book.sexp config/accounting-roles.tsv accounting-roles.tsv attention.loam; do
  if [ -f "$source/$f" ]; then git -C "$source" rm -q "$f"; fi
done
git -C "$source" commit -q -m "移行: 共通形式 book.txt（帳簿・会計上の役割・Attentionを1つのファイルに）"
printf 'Migrated and committed in %s (not pushed). The next tools/household run pushes it.\n' "$source"
