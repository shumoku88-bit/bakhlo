#!/bin/sh
# Use the existing isolated Ox/Bonsai switch. No installation or main-switch changes.
#   tools/build-bonsai-tui              build the TUI executable
#   tools/build-bonsai-tui --test [DIR] also run the Dune tests below tui/DIR
#                                       (all TUI suites when DIR is omitted)
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
test_dir=
case "$#:${1:-}" in
  0:) ;;
  1:--test) test_dir=tui ;;
  2:--test)
    case "$2" in
      ''|/*|*..*) printf '%s\n' 'Test directory must be relative to tui/.' >&2; exit 2 ;;
    esac
    test_dir=tui/$2 ;;
  *) printf '%s\n' 'Usage: tools/build-bonsai-tui [--test [DIR]]' >&2; exit 2 ;;
esac
workspace=daily-bonsai
trial=$root/scratch/tui_comparison_review
# CI opts into an independent OxCaml switch prepared by setup-ocaml; the
# default local entry retains its existing isolated trial environment.
case "${BAKHLO_BONSAI_CI:-0}" in
  0)
    if [ ! -x "$trial/bonsai-env/_opam/bin/ocamlopt" ] || [ ! -d "$trial/bonsai-env/_opam/lib/bonsai_term" ]; then
      printf '%s\n' 'Existing isolated Bonsai environment unavailable; nothing installed.' >&2
      exit 2
    fi ;;
  1)
    command -v opam >/dev/null 2>&1 || { printf '%s\n' 'CI opam missing.' >&2; exit 2; }
    ci_prefix=$(opam var prefix)
    if [ ! -x "$ci_prefix/bin/ocamlopt" ] || [ ! -d "$ci_prefix/lib/bonsai_term" ]; then
      printf '%s\n' 'CI OxCaml/Bonsai switch unavailable; not using the local trial.' >&2
      exit 2
    fi ;;
  *) printf '%s\n' 'BAKHLO_BONSAI_CI must be 0 or 1.' >&2; exit 2 ;;
esac
# Compiler ABIs differ: rebuild the SAME tracked sources in a separate build root.
# Do not use the archived/stale ox-build sources or copy household inputs.
build=$root/_build/$workspace
case "$build" in
  "$root/_build/daily-bonsai") ;;
  *) printf '%s\n' 'Unexpected generated UI build root.' >&2; exit 2 ;;
esac
if [ -L "$root/_build" ] || [ -L "$build" ]; then
  printf '%s\n' 'Generated UI build directories must not be symlinks.' >&2
  exit 2
fi
if [ -n "$(find "$root/tui" -type l)" ]; then
  printf '%s\n' 'The tui source tree must not contain symlinks.' >&2
  exit 2
fi
mkdir -p "$build"
# The generated sources are an exact snapshot of whole directories. Dune
# discovers every module and library itself, so nothing is registered here.
for dir in lib application sexp store tui; do
  if [ -L "$build/$dir" ]; then
    printf '%s\n' 'Generated source directories must not be symlinks.' >&2
    exit 2
  fi
  rm -rf "$build/$dir"
  cp -R "$root/$dir" "$build/$dir"
done
# Synthetic fixture shared by the TUI checks; never household data.
mkdir -p "$build/examples"
cp "$root/examples/daily-book.sexp" "$build/examples/daily-book.sexp"
# Undeclared transitive library use is a compile error: library boundaries
# are the architecture, see tui/README.md and tools/arch.
printf '%s\n' '(lang dune 3.24)' '(name bakhlo)' '(package (name bakhlo))' > "$build/dune-project"
printf '%s\n' '(lang dune 3.24)' '(implicit_transitive_deps false)' > "$build/tui/dune-project"
# A nested project does not inherit the root env: repeat the Core compiler policy.
printf '%s\n' '(env (_ (flags (:standard -strict-sequence -w +8+9+11 -warn-error +8+9+11))))' \
  > "$build/tui/dune"
printf '%s\n' '(dirs lib application sexp store tui examples)' \
  '(env (_ (flags (:standard -strict-sequence -w +8+9+11 -warn-error +8+9+11))))' > "$build/dune"
if [ "${BAKHLO_BONSAI_CI:-0}" = 0 ]; then
  export OPAMROOT=$trial/opam-root
  export OPAMSWITCH=$trial/bonsai-env
  export OPAMNOENVNOTICE=true
  export OPAMNODEPEXTS=true
  unset OCAMLPATH CAML_LD_LIBRARY_PATH OCAML_TOPLEVEL_PATH
  opam=$root/.tools/opam
else
  # Never install packages or modify the main project switch from this script.
  opam=opam
fi
"$opam" exec -- dune build --root "$build" --profile release tui/app/bonsai_daily.exe
if [ -n "$test_dir" ]; then
  exec "$opam" exec -- dune test --root "$build" --profile release --force "$test_dir"
fi
