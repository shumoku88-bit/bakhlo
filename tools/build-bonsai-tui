#!/bin/sh
# Use the existing isolated Ox/Bonsai switch. No installation or main-switch changes.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ "$#" -ne 0 ]; then
  printf '%s\n' 'Usage: tools/build-bonsai-tui' >&2
  exit 2
fi
name=bonsai_daily
workspace=daily-bonsai
trial=$root/scratch/tui_comparison_review
if [ ! -x "$trial/bonsai-env/_opam/bin/ocamlopt" ] || [ ! -d "$trial/bonsai-env/_opam/lib/bonsai_term" ]; then
  printf '%s\n' 'Existing isolated Bonsai environment unavailable; nothing installed.' >&2
  exit 2
fi
# Compiler ABIs differ: rebuild the SAME tracked sources in a separate build root.
# Do not use the archived/stale ox-build sources or copy household inputs.
build=$root/_build/$workspace
case "$build" in
  "$root/_build/daily-bonsai") ;;
  *) printf '%s\n' 'Unexpected generated UI build root.' >&2; exit 2 ;;
esac
if [ -L "$root/_build" ] || [ -L "$build" ] || [ -L "$build/ui" ]; then
  printf '%s\n' 'Generated UI build directories must not be symlinks.' >&2
  exit 2
fi
mkdir -p "$build/ui"
for dir in lib application sexp; do
  if [ -L "$build/$dir" ]; then
    printf '%s\n' 'Generated source directories must not be symlinks.' >&2
    exit 2
  fi
  mkdir -p "$build/$dir"
  # Keep the generated source snapshot exact, including removal of obsolete modules.
  rm -f "$build/$dir/"*.ml "$build/$dir/"*.mli
  cp "$root/$dir/"*.ml "$root/$dir/"*.mli "$root/$dir/dune" "$build/$dir/"
done
# Generated sources are an exact snapshot, including retired UI module removal.
rm -f "$build/ui/"*.ml "$build/ui/"*.mli
modules='daily_file ui_preferences ui_input ui_text posting_draft daily_actions daily_form daily_overlays ui_panel ui_form attention_data locus_roles balance_view_data settlement_data reversal_session date_correction_session scheduled_cancellation_session scheduled_continuation_session scheduled_bulk_session scheduled_bulk_checks scheduled_generation_session scheduled_generation_checks record_session scheduled_session actual_workspace actual_workspace_checks scheduled_session_checks record_session_checks daily_calendar scheduled_months ui_workspace daily_pace_trend ui_commands daily_interaction daily_interaction_checks recovery_checks bonsai_daily'
for module in $modules; do
  cp "$root/tui/$module.ml" "$build/ui/"
  if [ -f "$root/tui/$module.mli" ]; then
    cp "$root/tui/$module.mli" "$build/ui/"
  fi
done
printf '%s\n' '(lang dune 3.24)' '(name bakhlo)' '(package (name bakhlo))' > "$build/dune-project"
printf '%s\n' '(dirs lib application sexp ui)' '(env (_ (flags (:standard -strict-sequence -w +8+9+11 -warn-error +8+9+11))))' > "$build/dune"
printf '%s\n' "(executable (name $name) (modules $modules) (libraries bakhlo_domain bakhlo_application bakhlo_sexp zarith unix uutf bonsai_term async core))" > "$build/ui/dune"
export OPAMROOT=$trial/opam-root
export OPAMSWITCH=$trial/bonsai-env
export OPAMNOENVNOTICE=true
export OPAMNODEPEXTS=true
unset OCAMLPATH CAML_LD_LIBRARY_PATH OCAML_TOPLEVEL_PATH
exec "$root/.tools/opam" exec -- dune build --root "$build" --profile release "ui/$name.exe"
