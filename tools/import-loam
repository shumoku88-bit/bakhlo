#!/bin/sh
# Cutover-day import (user decision 2026-10-21): read a LOAM directory and create a
# NEW Bakhlo household directory. LOAM is only read; rehearse with a scratch destination.
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ "$#" -ne 2 ]; then
  printf '%s\n' 'Usage: tools/import-loam LOAM_DIRECTORY NEW_BAKHLO_DIRECTORY' >&2
  exit 2
fi
source=$(CDPATH= cd -- "$1" && pwd -P)
destination=$(CDPATH= cd -- "$(dirname -- "$2")" && pwd -P)/$(basename -- "$2")
revision=$(git -C "$source" rev-parse HEAD 2>/dev/null || printf 'unknown')
dirty=$(git --no-optional-locks -C "$source" status --porcelain 2>/dev/null | head -1 || true)
[ -z "$dirty" ] || revision="$revision (uncommitted changes present)"
cd "$root"
./tools/opam exec -- dune build migrate/bin/import_loam.exe
exec "$root/_build/default/migrate/bin/import_loam.exe" "$source" "$destination" "$revision"
