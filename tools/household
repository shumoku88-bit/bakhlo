#!/bin/sh
# Daily household launcher (user decision 2026-10-21): open the household book in
# the TUI, then on exit commit any change and push it to the household's own Git
# remote (an off-site backup). A failed push keeps the local commit and is
# retried next time, even without a new change. Any backup problem (staging,
# diff, commit, missing upstream, pending log, push) warns, keeps Git's own
# reason visible, and fails the exit; a nonzero TUI exit is reported unchanged
# and takes precedence.
#
# The launcher runs pushed code only (user decision 2026-10-22): AI workers edit
# and build the shared tree, so it never runs that tree. It fetches origin/main,
# keeps an ignored worktree at .run/src detached at that commit, builds the TUI
# there with the existing switch and installs the built binary at
# .run/bakhlo_tui.exe, which it always runs. The install copies to a temporary
# name and renames it, so a failed build (Dune may remove or replace its
# target) never takes the last good binary away. Its own _build means no Dune
# lock conflict with the shared tree. Offline keeps the last built binary; a
# failed build keeps it and names the commit; without any binary the launcher
# refuses.
# BAKHLO_HOUSEHOLD overrides the household directory (default: ../bakhlo-data).
set -u
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
household=${BAKHLO_HOUSEHOLD:-$root/../bakhlo-data}
run_dir=$root/.run
worktree=$run_dir/src
binary=$run_dir/bakhlo_tui.exe
target=$worktree/_build/default/tui/app/bakhlo_tui.exe
stamp=$run_dir/built-commit

if [ ! -f "$household/book.sexp" ] || [ ! -d "$household/.git" ]; then
  printf '%s\n' "Household not found or not a Git repository: $household" >&2
  exit 2
fi

warn() { printf '%s\n' "$*" >&2; }
short() { printf '%.7s' "$1"; }

# The commit to run: origin/main, fetched now. Offline keeps the last image.
want=
if git -C "$root" fetch -q origin main >/dev/null 2>&1; then
  want=$(git -C "$root" rev-parse --verify --quiet FETCH_HEAD 2>/dev/null || true)
  [ -n "$want" ] || want=$(git -C "$root" rev-parse --verify --quiet origin/main 2>/dev/null || true)
  [ -n "$want" ] || warn 'origin/main could not be resolved; the last built binary is used.'
else
  warn 'Offline: origin/main could not be fetched; the last built binary is used.'
fi

# The commit the ready binary was built from, and the commit the worktree holds.
built=$(cat "$stamp" 2>/dev/null || true)
head=$(git -C "$worktree" rev-parse --verify --quiet HEAD 2>/dev/null || true)

if [ -n "$want" ]; then
  if [ -z "$head" ]; then
    mkdir -p "$run_dir"
    if ! git -C "$root" worktree add --detach "$worktree" "$want" >/dev/null 2>&1; then
      # A leftover directory from an interrupted add is ours to clear.
      if [ -d "$worktree" ] && [ ! -e "$worktree/.git" ]; then
        rm -rf "$worktree"
      fi
      git -C "$root" worktree prune
      if git -C "$root" worktree add --detach "$worktree" "$want" >/dev/null 2>&1; then
        head=$want
      else
        warn 'The run worktree could not be created; the last built binary is used.'
      fi
    else
      head=$want
    fi
  elif [ "$head" != "$want" ]; then
    if git -C "$worktree" checkout --detach --force "$want" >/dev/null 2>&1; then
      head=$want
    else
      warn "The run worktree could not move to $(short "$want"); the last built binary is used."
    fi
  fi
  # A missing binary is rebuilt too: the stamp alone must not keep the launcher
  # from running.
  if [ -n "$head" ] && { [ "$built" != "$head" ] || [ ! -x "$binary" ]; }; then
    printf 'Building bakhlo %s …\n' "$(short "$head")"
    if "$root/tools/opam" exec -- dune build --root "$worktree" tui/app/bakhlo_tui.exe >/dev/null; then
      # Install atomically: a copy under a temporary name, then a rename.
      if cp "$target" "$binary.tmp.$$" && chmod 755 "$binary.tmp.$$" && mv -f "$binary.tmp.$$" "$binary"
      then
        built=$head
        printf '%s\n' "$built" > "$stamp"
      else
        rm -f "$binary.tmp.$$"
        warn "The build of $(short "$head") could not be installed; the last built binary is used."
      fi
    elif [ -x "$binary" ]; then
      warn "The build of $(short "$head") failed; the last built binary is used."
    else
      warn "The build of $(short "$head") failed; there is no binary to run."
    fi
  fi
fi

if [ ! -x "$binary" ]; then
  printf '%s\n' 'No TUI binary is built for the launcher; run it once online so the pushed code is built.' >&2
  exit 2
fi
[ -n "$built" ] || built=$(git -C "$worktree" rev-parse --verify --quiet HEAD 2>/dev/null || true)
printf 'Running bakhlo from commit %s\n' "$(short "$built")"

# Warn and stop: a nonzero TUI exit wins; otherwise the backup problem is the failure.
fail() {
  printf '%s\n' "$*" >&2
  if [ "$status" -ne 0 ]; then
    exit "$status"
  fi
  exit 1
}

cd "$root"
"$binary" --book "$household/book.sexp"
status=$?

if ! git -C "$household" add -A; then
  fail 'Household staging failed; the book was not committed or pushed.'
fi
git -C "$household" diff --cached --quiet
case $? in
  0) ;;
  1)
    if ! git -C "$household" commit -q -m "記帳 $(date '+%Y-%m-%d %H:%M')"; then
      fail 'Household commit failed; the change stays staged locally.'
    fi
    printf '%s\n' 'Household changes committed.'
    ;;
  *)
    fail 'Household diff failed; the book was not committed or pushed.'
    ;;
esac

# The upstream probe's "no upstream" error is expected; surface it with our warning.
if ! git -C "$household" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
  fail 'No upstream branch configured; local commits cannot be pushed.'
fi
if ! pending=$(git -C "$household" log --oneline '@{upstream}..'); then
  fail 'Failed to list pending commits; nothing was pushed.'
fi
if [ -n "$pending" ]; then
  if ! git -C "$household" push -q; then
    fail 'Push failed; the commit is kept locally and will be pushed next time.'
  fi
  printf '%s\n' 'Household backup pushed.'
fi

exit "$status"
