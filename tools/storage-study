#!/bin/sh
# Opt-in current-owner synthetic measurement, not a new backend or CI gate.
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"
if [ "$#" -eq 0 ]; then set -- 1000 36500 109500; fi
for count do
  case "$count" in ''|*[!0-9]*) printf '%s\n' 'Usage: tools/storage-study [ENTRY_COUNTS >= 20]' >&2; exit 2 ;; esac
  [ "$count" -ge 20 ] || exit 2
done
[ ! -L scratch ] || exit 2
mkdir -p scratch
run=$(mktemp -d "$root/scratch/storage-study-XXXXXX")
printf '%s\n' "Synthetic evidence: $run"
{
  date -u '+%Y-%m-%dT%H:%M:%SZ'
  git rev-parse HEAD
  uname -sm
  ./tools/opam exec -- ocamlopt -version
  ./tools/opam list --installed --columns=name,version base zarith parsexp sexplib0 dune
  df -k .
  shasum -a 256 tools/storage-study tools/storage_study.ml tui/daily_file.ml tui/daily_actions.ml \
    tui/ui_text.ml tui/posting_draft.ml sexp/daily_book.ml sexp/records_book.ml \
    sexp/durable_append.ml bakhlo.opam.locked
} > "$run/environment.txt"
./tools/opam exec -- dune build lib/bakhlo_domain.cmxa application/bakhlo_application.cmxa sexp/bakhlo_sexp.cmxa
for source in daily_file ui_text posting_draft daily_actions; do cp "tui/$source.ml" "$run/"; done
cp tools/storage_study.ml "$run/"
./tools/opam exec -- ocamlfind ocamlopt -strict-sequence -w +8+9+11 -warn-error +8+9+11 \
  -package base,zarith,parsexp,unix -linkpkg \
  -I _build/default/lib/.bakhlo_domain.objs/byte -I _build/default/lib/.bakhlo_domain.objs/native \
  -I _build/default/application/.bakhlo_application.objs/byte -I _build/default/application/.bakhlo_application.objs/native \
  -I _build/default/sexp/.bakhlo_sexp.objs/byte -I _build/default/sexp/.bakhlo_sexp.objs/native -I "$run" \
  _build/default/lib/bakhlo_domain.cmxa _build/default/application/bakhlo_application.cmxa \
  _build/default/sexp/bakhlo_sexp.cmxa "$run/daily_file.ml" "$run/ui_text.ml" \
  "$run/posting_draft.ml" "$run/daily_actions.ml" "$run/storage_study.ml" -o "$run/study"
"$run/study" probe > "$run/probe.txt"
printf '%s\n' "PASS: scoped opaque conversion probe (details in $run/probe.txt)"
for count do
  dir="$run/entries-$count"
  mkdir "$dir"
  "$run/study" generate "$dir" "$count" > "$dir/generate.txt" 2>&1
  for format in mono records; do
    if [ "$(uname -s)" = Darwin ]; then
      /usr/bin/time -l "$run/study" worker "$dir" "$format" "$count" > "$dir/$format.txt" 2> "$dir/$format.resources.txt"
    else
      "$run/study" worker "$dir" "$format" "$count" > "$dir/$format.txt" 2> "$dir/$format.resources.txt"
    fi
    printf '%s\n' "PASS: $count entries / $format (phase details in $dir/$format.txt)"
  done
done
printf '%s\n' 'No originals accessed; selected storage format unchanged. Filesystem cache not flushed.'
