#!/bin/sh
# Research only: identical synthetic operations in original and observed owners.
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"
if [ "$#" -eq 0 ]; then set -- 1000 36500 109500; fi
for count do
  case "$count" in ''|*[!0-9]*) printf '%s\n' 'Usage: tools/storage-breakdown [ENTRY_COUNTS >= 20]' >&2; exit 2 ;; esac
  [ "$count" -ge 20 ] || exit 2
done
[ ! -L scratch ] || exit 2
mkdir -p scratch
run=$(mktemp -d "$root/scratch/storage-breakdown-XXXXXX")
printf '%s\n' "Synthetic evidence: $run"
mkdir "$run/source" "$run/control" "$run/profile"
{
  date -u '+%Y-%m-%dT%H:%M:%SZ'
  git rev-parse HEAD
  uname -sm
  ./tools/opam exec -- ocamlopt -version
  ./tools/opam list --installed --columns=name,version base zarith parsexp sexplib0 dune
  df -k .
  shasum -a 256 tools/storage-breakdown tools/storage_breakdown.ml tools/storage_profile.ml \
    tools/storage_instrument.ml tools/storage_study.ml tui/daily_file.ml tui/daily_actions.ml \
    tui/ui_text.ml tui/posting_draft.ml sexp/daily_book.ml sexp/records_book.ml bakhlo.opam.locked
} > "$run/environment.txt"
for source in daily_file ui_text posting_draft daily_actions; do cp "tui/$source.ml" "$run/source/"; done
cp sexp/daily_book.ml tools/storage_study.ml tools/storage_profile.ml \
  tools/storage_instrument.ml tools/storage_breakdown.ml "$run/source/"
./tools/opam exec -- ocamlopt -strict-sequence -w +8+9+11 -warn-error +8+9+11 -I +unix \
  unix.cmxa "$run/source/storage_instrument.ml" -o "$run/instrument"
"$run/instrument" "$run/source" "$run/profile"
"$run/instrument" control "$run/source" "$run/control"
for variant in control profile; do
  for source in ui_text storage_profile storage_breakdown; do cp "$run/source/$source.ml" "$run/$variant/"; done
  if [ "$variant" = control ]; then
    for source in daily_file daily_actions posting_draft; do cp "$run/source/$source.ml" "$run/control/"; done
  fi
done
./tools/opam exec -- dune build lib/bakhlo_domain.cmxa application/bakhlo_application.cmxa sexp/bakhlo_sexp.cmxa
for variant in control profile; do
  extra=
  if [ "$variant" = profile ]; then extra="$run/profile/measured_daily_book.ml"; fi
  ./tools/opam exec -- ocamlfind ocamlopt -strict-sequence -w +8+9+11 -warn-error +8+9+11 \
    -package base,zarith,parsexp,unix -linkpkg -open Bakhlo_sexp \
    -I _build/default/lib/.bakhlo_domain.objs/byte -I _build/default/lib/.bakhlo_domain.objs/native \
    -I _build/default/application/.bakhlo_application.objs/byte -I _build/default/application/.bakhlo_application.objs/native \
    -I _build/default/sexp/.bakhlo_sexp.objs/byte -I _build/default/sexp/.bakhlo_sexp.objs/native -I "$run/$variant" \
    _build/default/lib/bakhlo_domain.cmxa _build/default/application/bakhlo_application.cmxa \
    _build/default/sexp/bakhlo_sexp.cmxa "$run/$variant/storage_profile.ml" $extra \
    "$run/$variant/daily_file.ml" "$run/$variant/ui_text.ml" "$run/$variant/posting_draft.ml" \
    "$run/$variant/daily_actions.ml" "$run/$variant/storage_study.ml" "$run/$variant/storage_breakdown.ml" \
    -o "$run/$variant/worker"
done
shasum -a 256 _build/default/lib/bakhlo_domain.cmxa _build/default/application/bakhlo_application.cmxa \
  _build/default/sexp/bakhlo_sexp.cmxa "$run"/control/*.ml "$run"/profile/*.ml > "$run/built-sources.sha256"
mkdir "$run/qualification" "$run/qualification/fixture"
"$run/control/worker" generate "$run/qualification/fixture" 20 > "$run/qualification/generate.txt" 2>&1
for variant in control profile; do
  mkdir "$run/qualification/$variant"
  cp "$run/qualification/fixture/initial.sexp" "$run/qualification/$variant/initial.sexp"
  "$run/$variant/worker" qualify "$run/qualification/$variant" > "$run/qualification/$variant.txt" 2>&1
  printf '%s\n' "PASS: $variant returned faults/refusals (not power-loss/P7)."
done
for count do
  dir="$run/entries-$count"
  mkdir "$dir" "$dir/fixture" "$dir/control" "$dir/profile"
  "$run/control/worker" generate "$dir/fixture" "$count" > "$dir/generate.txt" 2>&1
  for variant in control profile; do
    cp "$dir/fixture/initial.sexp" "$dir/$variant/state.sexp"
    if [ "$(uname -s)" = Darwin ]; then
      /usr/bin/time -l "$run/$variant/worker" worker "$dir/$variant" "$count" > "$dir/$variant.txt" 2> "$dir/$variant.resources.txt"
    else
      "$run/$variant/worker" worker "$dir/$variant" "$count" > "$dir/$variant.txt" 2> "$dir/$variant.resources.txt"
    fi
    printf '%s\n' "PASS: $count entries / $variant (raw stages in $dir/$variant.txt)"
  done
  cmp "$dir/control/state.sexp" "$dir/profile/state.sexp"
  cmp "$dir/control/restored.sexp" "$dir/profile/restored.sexp"
done
printf '%s\n' 'PASS: original/observed final bytes equal. No originals, GC tuning, new codec/backend, pruning or cache flush.'
