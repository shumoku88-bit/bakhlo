#!/bin/sh
# Notty trial: build the same tracked TUI sources with the project's own switch
# (ordinary OCaml + notty-community). No installation; nothing outside _build.
#   tools/build-notty-tui              build the Notty TUI executable
#   tools/build-notty-tui --test       also run every TUI suite available here
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
case "$#:${1:-}" in
  0:) test=false ;;
  1:--test) test=true ;;
  *) printf '%s\n' 'Usage: tools/build-notty-tui [--test]' >&2; exit 2 ;;
esac
build=$root/_build/daily-notty
if [ -L "$root/_build" ] || [ -L "$build" ] || [ -n "$(find "$root/tui" -type l)" ]; then
  printf '%s\n' 'Build and tui directories must not be symlinks.' >&2
  exit 2
fi
mkdir -p "$build"
for dir in lib application sexp store tui; do
  rm -rf "$build/$dir"
  cp -R "$root/$dir" "$build/$dir"
done
mkdir -p "$build/examples"
cp "$root/examples/daily-book.sexp" "$build/examples/daily-book.sexp"
printf '%s\n' '(lang dune 3.24)' '(name bakhlo)' '(package (name bakhlo))' > "$build/dune-project"
printf '%s\n' '(lang dune 3.24)' '(implicit_transitive_deps false)' > "$build/tui/dune-project"
printf '%s\n' '(env (_ (flags (:standard -strict-sequence -w +8+9+11 -warn-error +8+9+11))))' \
  > "$build/tui/dune"
printf '%s\n' '(dirs lib application sexp store tui examples)' \
  '(env (_ (flags (:standard -strict-sequence -w +8+9+11 -warn-error +8+9+11))))' > "$build/dune"
"$root/tools/opam" exec -- dune build --root "$build" --profile release tui/app/notty_daily.exe
if [ "$test" = true ]; then
  exec "$root/tools/opam" exec -- dune test --root "$build" --profile release --force tui
fi
