#!/bin/sh
# Download a checked local opam, create an isolated root/switch, install the lock.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"
version=2.6.0
compiler=5.3.0
registry=ac27950e5eac6c981ad809dff370c937820b7893
if [ ! -f bakhlo.opam.locked ]; then
    printf '%s\n' 'Dependency lock is missing; refusing an unlocked bootstrap.' >&2
    exit 1
fi

case "$(uname -s)/$(uname -m)" in
    Darwin/x86_64)
        platform=x86_64-macos
        digest=ebf457f96860d7e89e3aa68a8cbee6c8a8569a8f9677918fcf15c29e1873b072 ;;
    Darwin/arm64)
        platform=arm64-macos
        digest=b57ed6cc082e560063989a285c59786b7c670087da2d317a87e4ba4c7973e71f ;;
    Linux/x86_64)
        platform=x86_64-linux
        digest=a59184447f881005dae70b2ae455c3a7e9549834a41c635c49a5a28235eca758 ;;
    Linux/aarch64|Linux/arm64)
        platform=arm64-linux
        digest=aeaeb4294a9abaa7d37844d9138230125933c648e631da2eec888b5e4ce55bde ;;
    *) printf '%s\n' 'No checked opam binary configured for this platform.' >&2; exit 1 ;;
esac

for tool in curl git make cc tar patch pkg-config; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'Missing prerequisite: %s (no system packages are installed automatically).\n' \
            "$tool" >&2
        exit 1
    fi
done
if ! pkg-config --exists gmp; then
    printf '%s\n' 'GMP development files are missing; refusing automatic system installation.' >&2
    exit 1
fi
if command -v sha256sum >/dev/null 2>&1; then
    checksum() { sha256sum "$1" | cut -d ' ' -f 1; }
else
    command -v shasum >/dev/null
    checksum() { shasum -a 256 "$1" | cut -d ' ' -f 1; }
fi

mkdir -p .tools
if [ ! -f .tools/opam ]; then
    tmp=$(mktemp "$root/.tools/opam.XXXXXX")
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    curl --fail --silent --show-error --location \
        --proto '=https' --proto-redir '=https' --retry 3 \
        --output "$tmp" \
        "https://github.com/ocaml/opam/releases/download/$version/opam-$version-$platform"
    if [ "$(checksum "$tmp")" != "$digest" ]; then
        printf '%s\n' 'opam download checksum mismatch; refusing to execute.' >&2
        exit 1
    fi
    chmod 755 "$tmp"
    mv "$tmp" .tools/opam
    trap - EXIT HUP INT TERM
fi
if [ "$(checksum .tools/opam)" != "$digest" ]; then
    printf '%s\n' 'Local opam checksum mismatch; refusing to execute.' >&2
    exit 1
fi

# No shell hooks, global switch, or system package installation.
if [ ! -f .opam-root/config ]; then
    OPAMSWITCH= OPAMROOT="$root/.opam-root" .tools/opam init \
        --bare --no-setup --yes default \
        "git+https://github.com/ocaml/opam-repository.git#$registry"
fi
if [ ! -f _opam/.opam-switch/switch-state ]; then
    ./tools/opam switch create "$root" "ocaml-base-compiler.$compiler" \
        --no-install --yes --no-depexts
fi
actual=$(./tools/opam exec -- ocamlc -version)
if [ "$actual" != "$compiler" ]; then
    printf 'Expected OCaml %s, found %s; refusing to change an existing switch.\n' \
        "$compiler" "$actual" >&2
    exit 1
fi
./tools/opam install . --deps-only --with-test --locked --yes --no-depexts
printf '%s\n' 'Ready: ./tools/opam exec -- dune build @all' \
    'Tests: ./tools/opam exec -- dune runtest'
