#!/bin/sh
# Year-partitioned S-expression + Approach C prototype benchmark driver
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"

if [ "$#" -eq 0 ]; then set -- 1 10 30; fi

for years do
  case "$years" in ''|*[!0-9]*) printf '%s\n' 'Usage: tools/year-partition-study [YEARS >= 1]' >&2; exit 2 ;; esac
  [ "$years" -ge 1 ] || exit 2
done

[ ! -L scratch ] || exit 2
mkdir -p scratch
run=$(mktemp -d "$root/scratch/year-partition-study-XXXXXX")
printf '%s\n' "Year-partition study workspace: $run"

{
  date -u '+%Y-%m-%dT%H:%M:%SZ'
  git rev-parse HEAD
  uname -sm
  ./tools/opam exec -- ocamlopt -version
  ./tools/opam list --installed --columns=name,version base zarith parsexp sexplib0 dune
  df -k .
} > "$run/environment.txt"

./tools/opam exec -- dune build lib/bakhlo_domain.cmxa application/bakhlo_application.cmxa sexp/bakhlo_sexp.cmxa

cp tools/year_partition_study.ml "$run/"

./tools/opam exec -- ocamlfind ocamlopt -strict-sequence -w +8+9+11 -warn-error +8+9+11 \
  -package base,zarith,parsexp,unix -linkpkg \
  -I _build/default/lib/.bakhlo_domain.objs/byte -I _build/default/lib/.bakhlo_domain.objs/native \
  -I _build/default/application/.bakhlo_application.objs/byte -I _build/default/application/.bakhlo_application.objs/native \
  -I _build/default/sexp/.bakhlo_sexp.objs/byte -I _build/default/sexp/.bakhlo_sexp.objs/native -I "$run" \
  _build/default/lib/bakhlo_domain.cmxa _build/default/application/bakhlo_application.cmxa \
  _build/default/sexp/bakhlo_sexp.cmxa "$run/year_partition_study.ml" -o "$run/study"

for years do
  dir="$run/years-$years"
  mkdir "$dir"
  printf '\n============================================================\n'
  printf 'Running Year-Partition Benchmark for %d Years\n' "$years"
  printf '============================================================\n'
  
  "$run/study" generate "$dir" "$years" > "$dir/generate.txt" 2>&1
  
  if [ "$(uname -s)" = Darwin ]; then
    /usr/bin/time -l "$run/study" worker "$dir" "$years" 2> "$dir/resources.txt" | tee "$dir/output.txt"
  else
    "$run/study" worker "$dir" "$years" 2> "$dir/resources.txt" | tee "$dir/output.txt"
  fi
done

printf '\nYear-Partition Benchmark complete. Results saved in %s\n' "$run"
