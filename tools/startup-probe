#!/bin/sh
# Research only: synthetic startup, Marshal snapshot, save and in-memory response timings.
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"
if [ "$#" -eq 0 ]; then set -- 1000 36500 109500; fi
for count do
  case "$count" in ''|*[!0-9]*) printf '%s\n' 'Usage: tools/startup-probe [ENTRY_COUNTS]' >&2; exit 2 ;; esac
done
[ ! -L scratch ] || exit 2
mkdir -p scratch
run=$(mktemp -d "$root/scratch/startup-probe-XXXXXX")
printf '%s\n' "Synthetic evidence: $run"
{ date -u '+%Y-%m-%dT%H:%M:%SZ'; git rev-parse HEAD; uname -sm; ./tools/opam exec -- ocamlopt -version; } > "$run/environment.txt"
./tools/opam exec -- dune build book_txt/bakhlo_book_txt.cmxa household/bakhlo_household.cmxa store/bakhlo_store.cmxa store/libbakhlo_store_stubs.a
cp tools/startup_probe.ml "$run/"
./tools/opam exec -- ocamlfind ocamlopt -strict-sequence -w +8+9+11 -warn-error +8+9+11 \
  -package base,zarith,parsexp,unix -linkpkg \
  -I _build/default/book_txt/.bakhlo_book_txt.objs/byte -I _build/default/book_txt/.bakhlo_book_txt.objs/native \
  -I _build/default/household/.bakhlo_household.objs/byte -I _build/default/household/.bakhlo_household.objs/native \
  -I _build/default/store/.bakhlo_store.objs/byte -I _build/default/store/.bakhlo_store.objs/native \
  -I _build/default/store -ccopt -L_build/default/store \
  _build/default/book_txt/bakhlo_book_txt.cmxa _build/default/household/bakhlo_household.cmxa _build/default/store/bakhlo_store.cmxa "$run/startup_probe.ml" -o "$run/probe"
for count do
  dir="$run/entries-$count"
  mkdir "$dir"
  "$run/probe" gen "$dir" "$count"
  "$run/probe" detail "$dir"
  for _ in 1 2 3; do "$run/probe" load-txt "$dir"; "$run/probe" load-snap "$dir"; done
done | tee "$run/results.txt"
printf '%s\n' 'Synthetic only; no originals accessed. Filesystem cache not flushed.'
