#!/bin/sh
# English LOAM-compatible daily UI in the existing isolated Bonsai environment.
#   tools/tui --self-check   build and run every synthetic TUI check (dune test)
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"

if [ "$#" -eq 1 ] && [ "$1" = --self-check ]; then
  exec ./tools/build-bonsai-tui --test
fi
./tools/build-bonsai-tui
exec _build/daily-bonsai/_build/default/tui/app/bonsai_daily.exe "$@"
