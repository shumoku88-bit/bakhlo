#!/bin/sh
# Daily TUI (Bonsai_term only). Reuses the existing isolated Bonsai environment;
# no dependency installation.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"
case "${1:-}" in
  bonsai) shift ;; # accepted for older invocations
  notty)
    printf '%s\n' 'The Notty frontend was removed; use tools/tui without a frontend argument.' >&2
    exit 2
    ;;
esac
./tools/build-bonsai-tui
exec _build/daily-bonsai/_build/default/ui/bonsai_daily.exe "$@"
