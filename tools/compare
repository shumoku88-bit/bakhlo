#!/bin/sh
# Local comparison refresh through the one-time LOAM import (migrate/).
set -eu
umask 077
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"
case "${1:-}" in
  refresh|self-check|clean-copies) [ "$#" -eq 1 ] || exit 2 ;;
  *) printf '%s\n' 'Usage: tools/compare refresh | self-check | clean-copies' >&2; exit 2 ;;
esac
trial=$root/scratch/daily_book_candidate_v1
build=$root/scratch/loam-comparison-tools
state=$root/scratch/loam-comparison
if [ ! -f "$trial/household.sexp" ] || [ -L "$root/scratch" ] || [ -L "$build" ] || [ -L "$state" ]; then
  printf '%s\n' 'Private baseline unavailable or unsafe comparison directory. Nothing imported.' >&2
  exit 2
fi
mkdir -p "$build"
./tools/opam exec -- dune build lib/bakhlo_domain.cmxa application/bakhlo_application.cmxa \
  book_txt/bakhlo_book_txt.cmxa loam_read/bakhlo_loam_read.cmxa sexp/bakhlo_sexp.cmxa \
  migrate/bakhlo_migrate.cmxa
cp "$root/tools/compare_capture.ml" "$build/compare_capture.ml"
./tools/opam exec -- ocamlfind ocamlopt -strict-sequence -w +8+9+11 -warn-error +8+9+11 \
  -package base,zarith,parsexp,unix -linkpkg \
  -I _build/default/lib/.bakhlo_domain.objs/byte \
  -I _build/default/lib/.bakhlo_domain.objs/native \
  -I _build/default/application/.bakhlo_application.objs/byte \
  -I _build/default/application/.bakhlo_application.objs/native \
  -I _build/default/book_txt/.bakhlo_book_txt.objs/byte \
  -I _build/default/book_txt/.bakhlo_book_txt.objs/native \
  -I _build/default/loam_read/.bakhlo_loam_read.objs/byte \
  -I _build/default/loam_read/.bakhlo_loam_read.objs/native \
  -I _build/default/sexp/.bakhlo_sexp.objs/byte \
  -I _build/default/sexp/.bakhlo_sexp.objs/native \
  -I _build/default/migrate/.bakhlo_migrate.objs/byte \
  -I _build/default/migrate/.bakhlo_migrate.objs/native \
  -I "$build" \
  _build/default/lib/bakhlo_domain.cmxa _build/default/application/bakhlo_application.cmxa \
  _build/default/book_txt/bakhlo_book_txt.cmxa _build/default/loam_read/bakhlo_loam_read.cmxa _build/default/sexp/bakhlo_sexp.cmxa _build/default/migrate/bakhlo_migrate.cmxa \
  "$build/compare_capture.ml" -o "$build/compare-capture"
if [ "$1" = self-check ]; then
  exec "$build/compare-capture" self-check
fi
if [ "$1" = clean-copies ]; then
  exec "$build/compare-capture" clean-copies "$state"
fi
source=$(CDPATH= cd -- "$root/../loam-data" && pwd -P)
exec "$build/compare-capture" refresh "$source" "$state" "$trial/household.sexp"
