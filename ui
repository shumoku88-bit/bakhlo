#!/bin/sh
# A bk command on a copy: the latest household copy or a synthetic book. Never opens
# the household itself.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
cd "$root"
umask 077
usage() {
  printf '%s\n' './ui [COMMAND]          a bk command on the selected household copy (tools/household-copy)' \
    './ui --demo [COMMAND]  a bk command on a synthetic preview book'
}
mode=copy
case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --demo) mode=--demo; shift ;;
esac
if [ -L "$root/scratch" ]; then
  printf '%s\n' 'Copy directories must not be symlinks.' >&2; exit 2
fi
./tools/opam exec -- dune build --root . cli/bakhlo.exe
bin=$root/_build/default/cli/bakhlo.exe
if [ "$mode" = --demo ]; then
  trial=$root/scratch/ui-preview
  if [ -L "$trial" ]; then
    printf '%s\n' 'Preview directories must not be symlinks.' >&2; exit 2
  fi
  if [ ! -e "$trial" ]; then
    mkdir -p "$root/scratch"
    mkdir "$trial"
    "$bin" --copy-from examples/book.txt --book "$trial/book.txt"
  fi
else
  state=$root/scratch/household-copy
  if [ -L "$state" ] || [ -L "$state/CURRENT" ] || [ ! -f "$state/CURRENT" ]; then
    printf '%s\n' 'No selected household copy. Run ./tools/household-copy refresh. No demo fallback.' >&2
    exit 2
  fi
  IFS= read -r copy < "$state/CURRENT"
  case "$copy" in
    copy-*) ;;
    *) printf '%s\n' 'Invalid copy selector.' >&2; exit 2 ;;
  esac
  case "$copy" in
    *[!a-zA-Z0-9-]*) printf '%s\n' 'Invalid copy selector.' >&2; exit 2 ;;
  esac
  if [ "$(wc -l < "$state/CURRENT" | tr -d '[:space:]')" != 1 ]; then
    printf '%s\n' 'Invalid copy selector.' >&2; exit 2
  fi
  trial=$state/$copy
  if [ -L "$trial" ] || [ ! -f "$trial/COMPLETE" ]; then
    printf '%s\n' 'Incomplete household copy; nothing opened.' >&2; exit 2
  fi
fi
if [ ! -d "$trial" ] || [ -L "$trial/book.txt" ] || [ ! -f "$trial/book.txt" ]; then
  printf '%s\n' 'Book unavailable; existing trial was not replaced.' >&2
  exit 2
fi
exec "$bin" --book "$trial/book.txt" "$@"
