CANCEL-PLAN	gym-2027-02	2027-02-01
REFUSED	plan-cancelled
ENDAPPLY
# まだの予定は同じIDのまま日付と金額を変えられる。ファイル上の位置も同じ
APPLY	replace-open-plan
PUT-PLAN	REPLACE
PLAN	rent-2027-02	2027-02-28	jpy
CHANGE	bank	-82000
CHANGE	rent	82000
ENDPLAN
AFTER	replace-open-plan.after.txt
ENDAPPLY
# 払い済みの予定は書き換えられない
APPLY	refuse-replace-paid-plan
PUT-PLAN	REPLACE
PLAN	rent-2027-01	2027-01-27	jpy
CHANGE	bank	-81000
CHANGE	rent	81000
ENDPLAN
REFUSED	plan-already-paid
ENDAPPLY
# 新しい予定を払い済み・取消済みの形では作らない
APPLY	refuse-plan-already-ended
PUT-PLAN	NEW
PLAN	phone-2027-02	2027-02-25	jpy
CHANGE	bank	-3000
CHANGE	phone	3000
PAID-BY	tx-0002
ENDPLAN
REFUSED	plan-terminal-not-input
ENDAPPLY
# 使わなくなった科目（HIDDEN）へ新しい予定は作れない
APPLY	refuse-plan-hidden-locus
PUT-PLAN	NEW
PLAN	gym-2027-03	2027-03-10	jpy
CHANGE	bank	-5000
CHANGE	gym	5000
ENDPLAN
REFUSED	locus-unapproved
ENDAPPLY
# 予定のCHANGEも合計0でなければならない
APPLY	refuse-unbalanced-plan
PUT-PLAN	NEW
PLAN	phone-2027-02	2027-02-25	jpy
CHANGE	bank	-3000
CHANGE	phone	3240
ENDPLAN
REFUSED	invalid-plan-movement
ENDAPPLY
# 同じIDの予定を新しく作れない
APPLY	refuse-duplicate-plan
PUT-PLAN	NEW
PLAN	rent-2027-03	2027-03-27	jpy
CHANGE	bank	-80000
CHANGE	rent	80000
ENDPLAN
REFUSED	duplicate-plan
ENDAPPLY
# 変更はまとめて全部か何もしないか。払ったあと同じ予定を取り消すと、支払いも残らない
