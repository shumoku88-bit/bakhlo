# 期日より前に払ってよい。予定の期日は元のまま
APPLY	pay-early
PUT-ENTRY	NEW	rent-2027-02
TX	tx-0005	2027-02-20	DESC	rent
EFFECT	bank	jpy	-80000
EFFECT	rent	jpy	80000
ENDTX
AFTER	pay-early.after.txt
ENDAPPLY
# 払い済みの予定はもう一度払えない
APPLY	refuse-paid-plan
PUT-ENTRY	NEW	rent-2027-01
TX	tx-0005	2027-02-20	DESC	rent
EFFECT	bank	jpy	-80000
EFFECT	rent	jpy	80000
ENDTX
REFUSED	plan-already-paid
ENDAPPLY
# 取り消した予定は払えない
APPLY	refuse-cancelled-plan
PUT-ENTRY	NEW	gym-2027-02
TX	tx-0005	2027-02-01	DESC	phone bill
EFFECT	bank	jpy	-3000
EFFECT	phone	jpy	3000
ENDTX
REFUSED	plan-cancelled
ENDAPPLY
# ない予定は払えない
APPLY	refuse-unknown-plan
PUT-ENTRY	NEW	phone-2027-09
TX	tx-0005	2027-02-01	DESC	phone bill
EFFECT	bank	jpy	-3000
EFFECT	phone	jpy	3000
ENDTX
REFUSED	unknown-plan
ENDAPPLY
# 既存の実績をあとから予定に結び付けない。支払いは新しい実績だけ
APPLY	refuse-attach-on-edit
PUT-ENTRY	REPLACE	phone-2027-01
TX	tx-0002	2027-01-05
EFFECT	bank	jpy	-20000
EFFECT	wallet	jpy	20000
ENDTX
REFUSED	cannot-attach-plan-on-edit
ENDAPPLY
# 支払った実績を同じIDで訂正しても、予定とのリンクと予定の内容は変わらない
APPLY	correct-paying-entry
PUT-ENTRY	REPLACE	-
TX	tx-0004	2027-01-27	DESC	rent
EFFECT	bank	jpy	-81000
EFFECT	rent	jpy	81000
ENDTX
AFTER	correct-paying-entry.after.txt
ENDAPPLY
# 支払いの日付だけ直しても、予定の期日は変わらない
APPLY	move-paying-entry-date
CORRECT-ENTRY-DATE	tx-0004	2027-01-28
AFTER	move-paying-entry-date.after.txt
ENDAPPLY
# 支払いを取り消す実績を足しても、予定は払い済みのまま（開き直さない）
APPLY	reverse-paying-entry
PUT-ENTRY	NEW	-
TX	tx-0005	2027-02-02	DESC	rent refunded
EFFECT	bank	jpy	80000
EFFECT	rent	jpy	-80000
REVERSAL-OF	tx-0004
ENDTX
AFTER	reverse-paying-entry.after.txt
