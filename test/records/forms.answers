# 訂正で実績を開く・支払いや編集で予定を開くときのフォーム。
# 帳簿のEffectがそのまま行になり、順序・鍵・符号・Measureの小数桁を保つ。
USE	BOOK	open.txt
# 普通の2行の実績
OPEN	ENTRY	seed
MEASURE	jpy
ROW	b	bank	-100
ROW	f	food	100
ENDOPEN
# 同じLocusの複数行。scale 2では1.00のように小数桁をそろえて出す
OPEN	ENTRY	usd-split
MEASURE	usd
ROW	b	bank	-1.23
ROW	f1	food	0.23
ROW	f2	food	1.00
ENDOPEN
# まだの予定は鍵のない行で開く
OPEN	PLAN	open
MEASURE	jpy
ROW	-	bank	-300
ROW	-	food	300
ENDOPEN
# 払い済み・取消済みの予定は開かない
OPEN	PLAN	paid
REFUSED	plan-already-paid
ENDOPEN
OPEN	PLAN	cancelled
REFUSED	plan-cancelled
ENDOPEN
USE	BOOK	new-split.after.txt
# 原額と店のある実績も、Effectだけを行にして開く
OPEN	ENTRY	split
MEASURE	jpy
ROW	-	bank	-75
ROW	-	food	30
ROW	-	food	45
ENDOPEN
USE	BOOK	multi-measure.after.txt
# 2つのMeasureにまたがる実績は1つのMeasureのフォームにならない
OPEN	ENTRY	multi
REFUSED	single-measure-movement-required
ENDOPEN
USE	BOOK	new-exchange.after.txt
# 両替は訂正で開かない
OPEN	ENTRY	fx
REFUSED	linked-entry
ENDOPEN
USE	BOOK	refund-paid.after.txt
# 返金した実績とその返金も開かない
OPEN	ENTRY	seed
REFUSED	linked-entry
ENDOPEN
OPEN	ENTRY	refund
REFUSED	linked-entry
ENDOPEN
# Recordフォームの入力から実績を作る。日付→行の解析→原額のMeasure→釣合い→Bookの順に見る。
USE	BOOK	base.txt
# new-expression
FORM	NEW	-	fresh
DAY	２０２７／１／１２
MEMO	calculated meal
MEASURE	jpy
ROW	-	bank	-(500+300)/2
ROW	-	food	(100/3)*3
ROW	-	food	300
ORIGINAL	usd	50
ENDINPUT
RESULT	NEW	-
TX	fresh	2027-01-12	DESC	calculated meal
EFFECT	bank	jpy	-400
EFFECT	food	jpy	100
EFFECT	food	jpy	300
ORIGINAL	usd	50
ENDTX
ENDFORM
# edit-key
FORM	EDIT	seed	unused
DAY	2027.1.8
MEMO	changed locus
MEASURE	jpy
ROW	b	fee	-120
ROW	f	food	+120
ENDINPUT
RESULT	REPLACE	-
TX	seed	2027-01-08	DESC	changed locus
EFFECT	fee	jpy	-120
EFFECT	food	jpy	120	f
ENDTX
ENDFORM
USE	BOOK	new-split.after.txt
# edit-original
FORM	EDIT	split	unused
DAY	2027-01-13
MEMO	
MEASURE	jpy
ROW	-	bank	-80
ROW	-	food	30
ROW	-	food	50
ORIGINAL	usd	999
ENDINPUT
RESULT	REPLACE	-
TX	split	2027-01-13
EFFECT	bank	jpy	-80
EFFECT	food	jpy	30
EFFECT	food	jpy	50
ORIGINAL	usd	50
MERCHANT	sample-cafe
ENDTX
ENDFORM
USE	BOOK	base.txt
# edit-kept-keys
FORM	EDIT	seed	unused
DAY	2027-01-10
MEMO	meal
MEASURE	jpy
ROW	b	bank	-100
ROW	f	food	100
ENDINPUT
RESULT	REPLACE	-
TX	seed	2027-01-10	DESC	meal
EFFECT	bank	jpy	-100	b
EFFECT	food	jpy	100	f
ENDTX
ENDFORM
# pay-other-amount
FORM	PAY	open	paid-now
DAY	2027-01-12
MEMO	early payment
MEASURE	jpy
ROW	-	bank	-250
ROW	-	food	250
ENDINPUT
RESULT	NEW	open
TX	paid-now	2027-01-12	DESC	early payment
EFFECT	bank	jpy	-250
EFFECT	food	jpy	250
ENDTX
ENDFORM
# bad-day-first
FORM	NEW	-	fresh
DAY	not-a-day
MEMO	
MEASURE	jpy
ENDINPUT
REFUSED	day-format
ENDFORM
# impossible-day
FORM	NEW	-	fresh
DAY	2027-02-29
MEMO	
MEASURE	jpy
ENDINPUT
REFUSED	day-format
ENDFORM
# empty
FORM	NEW	-	fresh
DAY	2027-01-12
MEMO	
MEASURE	jpy
ENDINPUT
REFUSED	postings:posting-required
ENDFORM
# zero
FORM	NEW	-	fresh
DAY	2027-01-12
MEMO	
MEASURE	jpy
ROW	-	bank	-5
ROW	-	food	0
ENDINPUT
REFUSED	postings:row-2: non-positive-amount
ENDFORM
# precision
FORM	NEW	-	fresh
DAY	2027-01-12
MEMO	
MEASURE	usd
ROW	-	bank	-1.000
ROW	-	food	1
ENDINPUT
REFUSED	postings:row-1: amount-precision
ENDFORM
# parse-before-locus
FORM	NEW	-	fresh
DAY	2027-01-12
MEMO	
MEASURE	jpy
ROW	-		5
ROW	-	food	1/0
ENDINPUT
REFUSED	postings:row-2: division-by-zero
ENDFORM
# empty-locus
FORM	NEW	-	fresh
DAY	2027-01-12
MEMO	
MEASURE	jpy
ROW	-	bank	-5
ROW	-		5
ENDINPUT
REFUSED	postings:row-2: empty-locus
ENDFORM
# empty-measure
FORM	NEW	-	fresh
DAY	2027-01-12
MEMO	
MEASURE	
ROW	-	bank	-5
ROW	-	food	5
ENDINPUT
REFUSED	postings:row-1: unknown-measure
ENDFORM
# original-before-balance
FORM	NEW	-	fresh
DAY	2027-01-12
MEMO	
MEASURE	jpy
ROW	-	bank	-5
ROW	-	food	4
ORIGINAL	eur	10
ENDINPUT
REFUSED	original-measure
ENDFORM
# unbalanced
FORM	NEW	-	fresh
DAY	2027-01-12
MEMO	
MEASURE	jpy
ROW	-	bank	-5
ROW	-	food	4
ENDINPUT
REFUSED	unbalanced
ENDFORM
# duplicate
FORM	NEW	-	seed
DAY	2027-01-12
MEMO	
MEASURE	jpy
ROW	-	bank	-5
ROW	-	food	5
ENDINPUT
REFUSED	admission:duplicate-entry
ENDFORM
# paid
FORM	PAY	paid	fresh
DAY	2027-01-12
MEMO	
MEASURE	jpy
ROW	-	bank	-5
ROW	-	food	5
ENDINPUT
REFUSED	admission:plan-already-paid
ENDFORM
# unoffered
FORM	NEW	-	fresh
DAY	2027-01-12
MEMO	
MEASURE	jpy
ROW	-	bank	-5
ROW	-	old	5
ENDINPUT
REFUSED	admission:locus-unapproved
ENDFORM
