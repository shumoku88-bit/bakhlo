; Whole-program checks. They run outside a dependency sandbox because the writer
; refuses symlinked inputs, in a fresh temporary directory (not under _build, where
; Dune removes files it did not produce) seeded with the synthetic examples/ fixture.

(executable
 (name app_checks)
 (modules app_checks terminal_checks)
 (libraries
  bakhlo_tui_terminal
  bakhlo_tui_kit
  bakhlo_tui_book
  bakhlo_tui_shell
  bakhlo_tui_shell_checks
  bakhlo_screen_actual_checks
  bakhlo_screen_editors_checks
  bakhlo_tui_scenarios
  bakhlo.store
  bakhlo.household
  unix
  base
  notty-community))

(rule
 (alias runtest)
 (deps %{workspace_root}/examples/book.txt)
 (action
  (run %{exe:app_checks.exe} %{workspace_root})))

; Reports and the Actual's day totals against the language-neutral samples in
; test/reports (see its README).

(test
 (name report_answers)
 (modules report_answers)
 (libraries
  bakhlo_screen_reports
  bakhlo_screen_actual
  bakhlo_tui_book
  bakhlo.household
  zarith)
 (deps
  (glob_files %{workspace_root}/test/reports/*))
 (action
  (run %{test} %{workspace_root}/test/reports)))
