; Whole-program checks. They run outside a dependency sandbox because the
; writer refuses symlinked inputs, from the build root where the synthetic
; examples/ fixture and a scratch/ directory exist.

(executable
 (name app_checks)
 (libraries
  bakhlo_tui_terminal
  bakhlo_tui_kit
  bakhlo_tui_book
  bakhlo_tui_shell
  bakhlo_tui_shell_checks
  bakhlo_screen_actual_checks
  bakhlo_screen_editors_checks
  bakhlo_tui_scenarios
  bakhlo.store
  bakhlo.domain
  bakhlo.sexp
  unix
  base
  notty-community))

(rule
 (alias runtest)
 (deps %{workspace_root}/examples/daily-book.sexp)
 (action
  (run %{exe:app_checks.exe} %{workspace_root})))
